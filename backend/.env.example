# ============================================================
# SkillBridge AI - Backend Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Database
DATABASE_URL=sqlite:///./data/skillbridge.db

# JWT Security - change this in production!
SECRET_KEY=change-this-in-production

# AI API Keys (at least one for full AI features)
# Gemini
GEMINI_API_KEY=
# OpenAI
OPENAI_API_KEY=

# Optional tuning
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development
DEBUG_MODE=False
